#!/usr/bin/env -S pkl eval

extends "@deploy/Deploy.pkl"

name = "miniqr"
replicas = 2
image = "ghcr.io/lyqht/mini-qr:v0.31.0"
ports {
  new {
    containerPort = 8080
    svcPort = 80
    name = "http"
  }
}
livenessProbe {
  path = "/"
  port = "http"
}
readinessProbe {
  path = "/"
  port = "http"
}
startupProbe {
  path = "/"
  port = "http"
}
resourceRequirements {
  limits {
    ["cpu"] = "200m"
    ["memory"] = 256.mib
  }
  requests {
    ["cpu"] = "50m"
    ["memory"] = 128.mib
  }
}
