import "package://pkg.pkl-lang.org/pkl-k8s/k8s@1.4.1#/K8sResource.pkl"
import "sops:gitea.secrets.sops.pkl" as gitea_secret_file

import "@common/cnpg_backup.pkl"
import "@deploy/Deploy.pkl"
import "@k8s/api/apps/v1/Deployment.pkl"
import "@k8s/api/core/v1/ConfigMap.pkl"
import "@k8s/api/core/v1/Volume.pkl"

import "valkeyURL.pkl"

gitea =
  new Deploy {
    name = "gitea"
    namespace = "gitea"
    image = "docker.gitea.com/gitea:1.27.2-rootless"
    ports {
      new {
        containerPort = 3000
        svcPort = 80
        name = "http"
      }
      new {
        containerPort = 2222
        svcPort = 22
        name = "ssh"
      }
    }
    volumes {
      new {
        name = "gitea-data-pvc"
        size = 50.gib
        accessMode = "ReadWriteMany"
        containerPath = "/var/lib/gitea"
      }
      new {
        name = "gitea-config-pvc"
        size = 64.mib
        accessMode = "ReadWriteMany"
        containerPath = "/etc/gitea"
      }
    }
    livenessProbe {
      path = "/api/healthz"
      port = "http"
    }
    startupProbe {
      path = "/api/healthz"
      port = "http"
    }
    resourceRequirements {
      limits {
        ["cpu"] = "2"
        ["memory"] = 2.gib
      }
      requests {
        ["cpu"] = "1"
        ["memory"] = 512.mib
      }
    }
    env = new {
      ["GITEA__DEFAULT__RUN_USER"] = "git"
      ["GITEA__DEFAULT__RUN_MODE"] = "prod"
      ["GITEA__DEFAULT__APP_NAME"] = "prettysunflower's gitea"
      ["GITEA__DEFAULT__WORK_PATH"] = "/var/lib/gitea"
      ["GITEA__repository__ROOT"] = "/var/lib/gitea/git"
      ["GITEA__repository__SCRIPT_TYPE"] = "sh"
      ["GITEA__repository__DISABLE_STARS"] = "true"
      ["GITEA__server__STATIC_ROOT_PATH"] = "/usr/share/webapps/gitea"
      ["GITEA__server__APP_DATA_PATH"] = "/var/lib/gitea/data"
      ["GITEA__server__LFS_START_SERVER"] = "true"
      ["GITEA__server__SSH_DOMAIN"] = "gitea.gitea.svc.sekibanki.prettysunflower.moe"
      ["GITEA__server__DOMAIN"] = "git.prettysunflower.moe"
      ["GITEA__server__HTTP_PORT"] = "3000"
      ["GITEA__server__ROOT_URL"] = "https://git.prettysunflower.moe/"
      ["GITEA__server__DISABLE_SSH"] = "false"
      ["GITEA__server__SSH_PORT"] = "22"
      ["GITEA__server__OFFLINE_MODE"] = "false"
      ["GITEA__server__PUBLIC_URL_DETECTION"] = "auto"
      ["GITEA__database__DB_TYPE"] = "postgres"
      ["GITEA__database__SSL_MODE"] = "disable"
      ["GITEA__database__SCHEMA"] = "public"
      ["GITEA__database__LOG_SQL"] = "false"
      ["GITEA__session__PROVIDER"] = "db"
      //["GITEA__session__PROVIDER_CONFIG"] = valkeyURL.urlForService(valkeyURL.gitea)
      ["GITEA__log__MODE"] = "console"
      ["GITEA__log__LEVEL"] = "info"
      ["GITEA__mailer__ENABLED"] = "true"
      ["GITEA__mailer__FROM"] = "gitea@prettysunflower.moe"
      ["GITEA__mailer__PROTOCOL"] = "smtp+starttls"
      ["GITEA__mailer__SMTP_ADDR"] = "mail.prettysunflower.moe"
      ["GITEA__mailer__SMTP_PORT"] = "587"
      ["GITEA__storage__STORAGE_TYPE"] = "minio"
      ["GITEA__storage__MINIO_ENDPOINT"] = "t3.storage.dev:443"
      ["GITEA__storage__MINIO_ACCESS_KEY_ID"] =
        "tid_uCZAvxLOlpVdEusuMYvVmsOvMgVccrwxGJwqauuhSucI_MwddN"
      ["GITEA__storage__MINIO_BUCKET"] = "prettysunflower-gitea"
      ["GITEA__storage__MINIO_LOCATION"] = "auto"
      ["GITEA__storage__MINIO_USE_SSL"] = "true"
      ["GITEA__storage__SERVE_DIRECT"] = "true"
      ["GITEA__service__REGISTER_EMAIL_CONFIRM"] = "false"
      ["GITEA__service__ENABLE_NOTIFY_MAIL"] = "false"
      ["GITEA__service__ALLOW_ONLY_EXTERNAL_REGISTRATION"] = "true"
      ["GITEA__service__ENABLE_CAPTCHA"] = "false"
      ["GITEA__service__REQUIRE_SIGNIN_VIEW"] = "false"
      ["GITEA__service__DEFAULT_KEEP_EMAIL_PRIVATE"] = "false"
      ["GITEA__service__DEFAULT_ALLOW_CREATE_ORGANIZATION"] = "true"
      ["GITEA__service__DEFAULT_ENABLE_TIMETRACKING"] = "true"
      ["GITEA__service__NO_REPLY_ADDRESS"] = "noreply.localhost"
      ["GITEA__openid__ENABLE_OPENID_SIGNIN"] = "true"
      ["GITEA__openid__ENABLE_OPENID_SIGNUP"] = "true"
      ["GITEA__cron_0X2E_update_checker__ENABLED"] = "false"
      ["GITEA__repository_0X2E_pull_0X2D_request__DEFAULT_MERGE_STYLE"] = "merge"
      ["GITEA__repository_0X2E_signing__DEFAULT_TRUST_MODEL"] = "committer"
      ["GITEA__security__INSTALL_LOCK"] = "true"
      ["GITEA__security__PASSWORD_HASH_ALGO"] = "argon2"
      ["GITEA__cache__ADAPTER"] = "memory"
      //["GITEA__cache__HOST"] = valkeyURL.urlForService(valkeyURL.gitea)
      ["GITEA__ui__THEMES"] = "gitea-light,gitea-dark,gitea-auto"
      ["GITEA__ui__DEFAULT_THEME"] = "gitea-auto"
    }
    secrets = gitea_secret_file.secrets
    pgDb = new {
      envMapping {
        host = "GITEA__database__HOST"
        username = "GITEA__database__USER"
        password = "GITEA__database__PASSWD"
        dbname = "GITEA__database__NAME"
      }
      backup = cnpg_backup
      size = 10.gib
      storageClass = "local-path-ssd"
      instances = 3
    }
  }.resources

anubis =
  new Deploy {
    name = "gitea"
    namespace = "anubis"
    labels {
      ["app.kubernetes.io/name"] = "anubis-gitea"
    }
    image = "ghcr.io/techarohq/anubis:v1.25.0"
    secrets = gitea_secret_file.anubis_secrets
    env {
      ["BIND"] = ":8923"
      ["METRICS_BIND"] = ":9090"
      ["TARGET"] = "http://gitea.gitea.svc.sekibanki.prettysunflower.moe"
      ["WEBMASTER_EMAIL"] = "me@prettysunflower.moe"
    }
    ports {
      new {
        containerPort = 8923
        svcPort = 80
        name = "http"
      }
      new {
        containerPort = 9090
        svcPort = 9090
        name = "metrics"
      }
    }
    resourceRequirements {
      limits {
        ["cpu"] = "750m"
        ["memory"] = 256.mib
      }
      requests {
        ["cpu"] = "250m"
        ["memory"] = 64.mib
      }
    }
    livenessProbe {
      port = "metrics"
      path = "/healthz"
    }
    startupProbe {
      port = "metrics"
      path = "/healthz"
    }

    // Deployment override for config file
    deployment {
      spec {
        template {
          spec {
            volumes {
              new Volume {
                name = "config"
                configMap {
                  name = "gitea-anubis-config"
                }
              }
            }
            containers {
              [0] {
                envFrom {
                  new {
                    secretRef {
                      name = "thoth"
                    }
                  }
                }
                volumeMounts {
                  new {
                    name = "config"
                    mountPath = "/data/cfg/botPolicy.yaml"
                    subPath = "anubis-config.yaml"
                  }
                }
              }
            }
          }
        }
      }
    }
  }.resources

anubisGiteaConfig = new ConfigMap {
  metadata {
    name = "gitea-anubis-config"
    namespace = "anubis"
  }
  data {
    ["anubis-config.yaml"] = read("gitea/anubis-config.yaml").text
  }
}

output {
  value = new Listing {
    ...gitea
    ...anubis
    anubisGiteaConfig
  }
  renderer = (K8sResource.output.renderer as YamlRenderer) {
    isStream = true
  }
}
