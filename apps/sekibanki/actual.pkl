amends "@deploy/Deploy.pkl"

name = "actual"
image = "actualbudget/actual-server:26.6.0"

ports {
  new {
    containerPort = 5006
    svcPort = 80
    name = "http"
  }
}

volumes {
  new {
    name = "actual-pvc"
    size = 5.gib
    containerPath = "/data"
    accessMode = "ReadWriteOnce"
  }
}

resourceRequirements {
  limits {
    ["cpu"] = "500m"
    ["memory"] = 512.mib
  }
  requests {
    ["cpu"] = "100m"
    ["memory"] = 128.mib
  }
}

livenessProbe {
  path = "/"
  port = "http"
}

readinessProbe {
  path = "/"
  port = "http"
}

startupProbe {
  path = "/"
  port = "http"
}

env {
  ["ACTUAL_PORT"] = "5006"
}
