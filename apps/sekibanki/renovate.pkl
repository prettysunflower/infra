import "sops:renovate.secrets.sops.pkl" as secrets_file

import "@deploy/Deploy.pkl"
import "@k8s/api/batch/v1/CronJob.pkl"
import "@k8s/api/core/v1/ConfigMap.pkl"
import "@k8s/api/core/v1/Secret.pkl"
import "@k8s/K8sResource.pkl"

import "valkeyURL.pkl"

secret = new Secret {
  metadata {
    name = "renovate-secrets"
  }
  stringData = secrets_file.secrets
}

configMap = new ConfigMap {
  metadata {
    name = "renovate-configmap"
  }
  data {
    ["RENOVATE_AUTODISCOVER"] = "true"
    ["RENOVATE_ENDPOINT"] = "https://git.prettysunflower.moe/api/v1"
    ["RENOVATE_GIT_AUTHOR"] = "Renovate Bot <renovatebot@prettysunflower.moe>"
    ["RENOVATE_PLATFORM"] = "gitea"
    ["RENOVATE_KUBERNETES"] = "{\"fileMatch\":[\"\\.yaml$\"]}"
    ["RENOVATE_PR_HOURLY_LIMIT"] = "0"
    ["RENOVATE_CACHE_HARD_TTL_MINUTES"] = "60"
    ["RENOVATE_REDIS_URL"] = valkeyURL.urlForService(valkeyURL.renovate)
    ["RENOVATE_DETECT_HOST_RULES_FROM_ENV"] = "true"
  }
}

cronjob = new CronJob {
  metadata {
    name = "renovate-gitea"
  }
  spec {
    schedule = "*/15 9-22 * * *"
    concurrencyPolicy = "Forbid"
    jobTemplate {
      spec {
        template {
          spec {
            containers {
              new {
                name = "renovate"
                image = "renovate/renovate:latest"
                env {
                  new {
                    name = "LOG_LEVEL"
                    value = "debug"
                  }
                }
                envFrom {
                  new {
                    configMapRef {
                      name = configMap.metadata.name
                    }
                  }
                  new {
                    secretRef {
                      name = "renovate-secrets"
                    }
                  }
                }
                resources {
                  limits {
                    ["cpu"] = "1"
                    ["memory"] = 512.mib
                  }
                  requests {
                    ["cpu"] = "250m"
                    ["memory"] = 128.mib
                  }
                }
              }
            }
            restartPolicy = "Never"
          }
        }
      }
    }
  }
}

output {
  value = new Listing<K8sResource> {
    secret
    configMap
    cronjob
  }
  renderer = (K8sResource.output.renderer as YamlRenderer) {
    isStream = true
  }
}
