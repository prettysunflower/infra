import "@cnpg/Database.pkl"
import "@k8s/K8sResource.pkl"
import "@deploy/Deploy.pkl"

deneb =
  new Deploy {
    name = "sonarr-deneb"
    namespace = "sonarr"
    image = "ghcr.io/linuxserver/sonarr:4.0.19.2979-ls316"
    ports {
      new {
        containerPort = 8989
        svcPort = 80
        name = "http"
      }
    }
    volumes {
      new {
        name = "deneb-config"
        size = 5.gib
        accessMode = "ReadWriteOnce"
        containerPath = "/config"
      }
      new {
        name = "pvc-medias-deneb"
        pvName = "pv-sonarr-media-deneb"
        size = 2.tib
        accessMode = "ReadWriteMany"
        containerPath = "/synology"
        hostPath = "/var/mnt/yuyuko/deneb"
      }
    }
    livenessProbe {
      path = "/ping"
      port = "http"
    }
    startupProbe {
      path = "/ping"
      port = "http"
    }
    env {
      ["PUID"] = "1000"
      ["PGID"] = "1000"
      ["TZ"] = "America/Toronto"
    }
    pgDb {
      name = "pg-deneb"
      instances = 2
      size = 5.gib
      storageClass = "local-path-ssd"
    }
    service {
      metadata {
        name = "deneb"
      }
    }
  }.resources

remilia =
  new Deploy {
    name = "sonarr-remilia"
    namespace = "sonarr"
    image = "ghcr.io/linuxserver/sonarr:4.0.19.2979-ls316"
    ports {
      new {
        containerPort = 8989
        svcPort = 80
        name = "http"
      }
    }
    volumes {
      new {
        name = "remilia-config"
        size = 5.gib
        accessMode = "ReadWriteOnce"
        containerPath = "/config"
      }
      new {
        name = "pvc-medias-remilia"
        pvName = "pv-sonarr-media-remilia"
        size = 2.tib
        accessMode = "ReadWriteMany"
        containerPath = "/data"
        hostPath = "/var/mnt/yuyuko/media/"
      }
    }
    livenessProbe {
      path = "/ping"
      port = "http"
    }
    startupProbe {
      path = "/ping"
      port = "http"
    }
    env {
      ["PUID"] = "1000"
      ["PGID"] = "1000"
      ["TZ"] = "America/Toronto"
    }
    pgDb {
      name = "pg-remilia"
      instances = 2
      size = 5.gib
      storageClass = "local-path-ssd"
    }
    service {
      metadata {
        name = "remilia"
      }
    }
  }.resources

denebLogsDb = new Database {
  metadata {
    name = "pg-deneb-logs"
    namespace = "sonarr"
  }
  spec {
    name = "sonarr-logs"
    owner = "app"
    cluster {
      name = "pg-deneb"
    }
  }
}

remiliaLogsDb = new Database {
  metadata {
    name = "pg-remilia-logs"
    namespace = "sonarr"
  }
  spec {
    name = "sonarr-logs"
    owner = "app"
    cluster {
      name = "pg-remilia"
    }
  }
}

output {
  value = new Listing<K8sResource> {
    ...deneb
    ...remilia
    denebLogsDb
    remiliaLogsDb
  }
  renderer = (K8sResource.output.renderer as YamlRenderer) {
    isStream = true
  }
}
