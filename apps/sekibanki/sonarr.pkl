import "@cnpg/Database.pkl"
import "@k8s/K8sResource.pkl"
import "@deploy/Deploy.pkl"
import "@k8s/api/core/v1/Volume.pkl"
import "@k8s/api/core/v1/VolumeMount.pkl"

deneb =
  new Deploy {
    name = "sonarr-deneb"
    namespace = "sonarr"
    image = "ghcr.io/linuxserver/sonarr:4.0.19.2979-ls321"
    ports {
      new {
        containerPort = 8989
        svcPort = 80
        name = "http"
      }
    }
    volumes {
      new {
        name = "deneb-config"
        size = 5.gib
        accessMode = "ReadWriteOnce"
        containerPath = "/config"
      }
      new {
        name = "pvc-medias-deneb"
        pvName = "pv-sonarr-media-deneb"
        size = 2.tib
        accessMode = "ReadWriteMany"
        containerPath = "/synology"
        hostPath = "/var/mnt/yuyuko/deneb"
      }
    }
    livenessProbe {
      path = "/ping"
      port = "http"
    }
    startupProbe {
      path = "/ping"
      port = "http"
    }
    securityContext = null
    env {
      ["PUID"] = "1000"
      ["PGID"] = "1000"
      ["TZ"] = "America/Toronto"
      ["S6_YES_I_WANT_A_WORLD_WRITABLE_RUN_BECAUSE_KUBERNETES"] = "1"
      ["S6_READ_ONLY_ROOT"] = "1"
    }
    pgDb {
      name = "pg-deneb"
      instances = 3
      size = 5.gib
      storageClass = "local-path-ssd"
    }
    service {
      metadata {
        name = "deneb"
      }
    }
    deployment {
      spec {
        template {
          spec {
            volumes {
              new Volume {
                name = "run"
                emptyDir {
                  sizeLimit = "500Mi"
                  medium = "Memory"
                }
              }
            }
            containers {
              [0] {
                volumeMounts {
                  new VolumeMount {
                    name = "run"
                    mountPath = "/run"
                  }
                }
              }
            }
          }
        }
      }
    }
  }.resources

remilia =
  new Deploy {
    name = "sonarr-remilia"
    namespace = "sonarr"
    image = "ghcr.io/linuxserver/sonarr:4.0.19.2979-ls321"
    ports {
      new {
        containerPort = 8989
        svcPort = 80
        name = "http"
      }
    }
    volumes {
      new {
        name = "remilia-config"
        size = 5.gib
        accessMode = "ReadWriteOnce"
        containerPath = "/config"
      }
      new {
        name = "pvc-medias-remilia"
        pvName = "pv-sonarr-media-remilia"
        size = 2.tib
        accessMode = "ReadWriteMany"
        containerPath = "/data"
        hostPath = "/var/mnt/yuyuko/media/"
      }
    }
    livenessProbe {
      path = "/ping"
      port = "http"
    }
    startupProbe {
      path = "/ping"
      port = "http"
    }
    securityContext = null
    env {
      ["PUID"] = "1000"
      ["PGID"] = "1000"
      ["TZ"] = "America/Toronto"
      ["S6_YES_I_WANT_A_WORLD_WRITABLE_RUN_BECAUSE_KUBERNETES"] = "true"
      ["S6_READ_ONLY_ROOT"] = "1"
    }
    pgDb {
      name = "pg-remilia"
      instances = 3
      size = 5.gib
      storageClass = "local-path-ssd"
    }
    service {
      metadata {
        name = "remilia"
      }
    }
    deployment {
      spec {
        template {
          spec {
            volumes {
              new Volume {
                name = "run"
                emptyDir {
                  sizeLimit = "500Mi"
                  medium = "Memory"
                }
              }
            }
            containers {
              [0] {
                volumeMounts {
                  new VolumeMount {
                    name = "run"
                    mountPath = "/run"
                  }
                }
              }
            }
          }
        }
      }
    }
  }.resources

denebLogsDb = new Database {
  metadata {
    name = "pg-deneb-logs"
    namespace = "sonarr"
  }
  spec {
    name = "sonarr-logs"
    owner = "app"
    cluster {
      name = "pg-deneb"
    }
  }
}

remiliaLogsDb = new Database {
  metadata {
    name = "pg-remilia-logs"
    namespace = "sonarr"
  }
  spec {
    name = "sonarr-logs"
    owner = "app"
    cluster {
      name = "pg-remilia"
    }
  }
}

output {
  value = new Listing<K8sResource> {
    ...deneb
    ...remilia
    denebLogsDb
    remiliaLogsDb
  }
  renderer = (K8sResource.output.renderer as YamlRenderer) {
    isStream = true
  }
}
