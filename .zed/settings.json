{
  "prettier": {
    "allowed": true,
    "tabWidth": 2
  },
  "lsp": {
    "yaml-language-server": {
      "settings": {
        "yaml": {
          "schemaStore": {
            "enable": true
          },
          "completion": true,
          "schemas": {
            "kubernetes": "**.yaml"
          }
        }
      }
    },
    "Pkl": {
      "binary": {
        "path": "/usr/bin/java",
        "arguments": [
          "-jar",
          "/home/prettysunflower/.config/pkl-lsp-0.8.0-SNAPSHOT.jar"
        ]
      },
      "initialization_options": {
        "pkl": {
          "cli": {
            "path": "/usr/bin/pkl"
          }
        }
      }
    }
  },
  "languages": {
    "Pkl": {
      "language_servers": ["pkl", "sops-lsp"],
      "tab_size": 4,
      "formatter": "language_server",
      "format_on_save": "on"
    }
  }
}
